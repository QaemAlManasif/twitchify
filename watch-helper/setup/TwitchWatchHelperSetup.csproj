<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Twitch Watch Sync Setup</AssemblyName>
    <RootNamespace>TwitchWatchHelperSetup</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <Company>QAEM</Company>
    <Product>Twitchify Watch Sync Setup</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Trimming is unsupported with Windows Forms -->
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <ApplicationIcon>../app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Publish the helper first: dotnet publish -c Release -o publish (in ..) -->
    <EmbeddedResource Include="..\publish\TwitchWatchHelper.exe">
      <LogicalName>helper.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
